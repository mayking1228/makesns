# Example only. Activate after checking DNS, existing Nginx hosts and the chosen domain.
# Add www.makesns.com only after its DNS is configured and its certificate can be issued.
server {
    listen 80;
    server_name makesns.com;
    root /opt/makesns/current/site;
    index index.html;
    access_log /var/log/nginx/makesns-access.log;
    error_log /var/log/nginx/makesns-error.log;
    client_max_body_size 1m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # Inline scripts are Next.js static hydration data; no external scripts are used.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://*.google-analytics.com; connect-src 'self' https://*.google-analytics.com; font-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; default_type text/plain; try_files $uri =404; }
    location / { try_files $uri $uri/ =404; }
    location ^~ /_next/static/ { expires 1y; try_files $uri =404; }
    location ~ /\. { deny all; }
    error_page 404 /404.html;
}
